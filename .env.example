# =====================================================================
# 复制为 .env 后填入你自己的值：cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交
# =====================================================================

# ── 数据库 ──────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=gateway
# 宿主机映射端口（3306 常被本机 MySQL 占用，默认 13306）
MYSQL_HOST_PORT=13306

# ── RabbitMQ ────────────────────────────────────────────
RABBIT_USER=gateway
RABBIT_PASS=change-me-strong-password

# ── 管理端凭证（必填，无默认值）─────────────────────────
ADMIN_USERNAME=admin
# 可用明文（启动时自动 BCrypt）或直接填 BCrypt 哈希（$2a$/$2b$ 开头）
ADMIN_PASSWORD=change-me-at-least-8-chars
# 生成方式：openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-please-generate-a-32-byte-random-secret

# ── 演示用客户端 API Key ────────────────────────────────
DEMO_API_KEY=sk-lg-demo-key-local

# ── 端口 ────────────────────────────────────────────────
GATEWAY_PORT=18081

# ── 时区 ────────────────────────────────────────────────
TZ=Asia/Shanghai
